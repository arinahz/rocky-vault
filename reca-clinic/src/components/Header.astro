---
import Icon from './Icon.astro';
import { clinic } from '../data/clinic';
import { telLink } from '../lib/whatsapp';

const nav = [
  { href: '/perkhidmatan/', label: 'Perkhidmatan' },
  { href: '/doktor/', label: 'Doktor' },
  { href: '/ulasan/', label: 'Ulasan' },
  { href: '/hubungi/', label: 'Hubungi' },
];
const path = Astro.url.pathname;
---

<header class="sticky top-0 z-30 border-b border-line bg-white/95 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4">
    <a href="/" class="flex items-center gap-2.5 text-ink no-underline">
      <span class="flex size-[34px] items-center justify-center rounded-[10px] bg-brand text-[17px] font-extrabold text-white">R</span>
      <span class="flex flex-col leading-tight">
        <span class="text-[17px] font-extrabold">{clinic.name}</span>
        <span class="text-[11px] text-muted">{clinic.area}</span>
      </span>
    </a>

    <nav aria-label="Menu utama" class="hidden items-center gap-1 md:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={path.startsWith(item.href) ? 'page' : undefined}
            class="rounded-lg px-3 py-2 text-[15px] font-semibold text-body no-underline hover:bg-tint hover:text-brand aria-[current=page]:text-brand"
          >
            {item.label}
          </a>
        ))
      }
      <a href={telLink} data-track="contact" class="ml-2 flex items-center gap-2 rounded-lg px-3 py-2 text-[15px] font-bold text-brand no-underline hover:bg-tint">
        <Icon name="phone" size={18} />{clinic.phoneDisplay}
      </a>
    </nav>

    <div class="flex gap-1 md:hidden">
      <a href={telLink} data-track="contact" aria-label="Telefon klinik" class="flex size-11 items-center justify-center rounded-xl text-brand">
        <Icon name="phone" />
      </a>
      <details class="group">
        <summary aria-label="Buka menu" class="flex size-11 items-center justify-center rounded-xl text-ink">
          <Icon name="menu" size={24} class="group-open:hidden" />
          <Icon name="close" size={24} class="hidden group-open:block" />
        </summary>
        <nav aria-label="Menu utama" class="absolute inset-x-0 top-16 border-b border-line bg-white px-4 pt-2 pb-4 shadow-lg">
          {
            nav.map((item) => (
              <a href={item.href} class="flex min-h-12 items-center border-b border-line text-base font-semibold text-ink no-underline last:border-0">
                {item.label}
              </a>
            ))
          }
        </nav>
      </details>
    </div>
  </div>
</header>
