---
import Icon from './Icon.astro';
import type { Service } from '../data/clinic';

interface Props {
  service: Service;
  index: number;
}
const { service, index } = Astro.props;
---

<a href={`/perkhidmatan/${service.slug}/`} class="flex min-h-11 items-center gap-3.5 rounded-2xl border border-line p-4 text-ink no-underline transition-colors hover:border-line-strong hover:bg-tint/50">
  <span class="flex size-[46px] flex-none items-center justify-center rounded-xl bg-tint text-base font-extrabold text-brand">
    {String(index + 1).padStart(2, '0')}
  </span>
  <span class="flex flex-1 flex-col gap-0.5">
    <span class="text-base font-bold">{service.name}</span>
    <span class="text-[13px] leading-snug text-muted">{service.short}</span>
  </span>
  <Icon name="chevron" size={20} class="text-gray-500" />
</a>
