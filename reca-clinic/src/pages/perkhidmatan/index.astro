---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import { clinic, services } from '../../data/clinic';
---

<BaseLayout
  title={`Perkhidmatan | ${clinic.name}, ${clinic.area}`}
  description={`Senarai perkhidmatan di ${clinic.name}, ${clinic.area}. Tanya tentang mana-mana rawatan terus melalui WhatsApp.`}
  waTopic={`perkhidmatan di ${clinic.name}`}
>
  <section class="bg-tint">
    <div class="mx-auto max-w-6xl px-4 py-8 md:py-14">
      <nav aria-label="Breadcrumb" class="mb-4 flex items-center gap-1.5 text-[13px] text-muted">
        <a href="/" class="text-muted no-underline">Utama</a><span aria-hidden="true">/</span><span class="font-semibold text-ink">Perkhidmatan</span>
      </nav>
      <h1 class="mb-3 text-[30px] leading-[1.15] font-extrabold tracking-[-0.02em] md:text-[44px]">Perkhidmatan di {clinic.name}</h1>
      <p class="max-w-2xl text-base leading-relaxed text-body">Pilih perkhidmatan untuk maklumat lanjut, atau tanya kami di WhatsApp jika anda tidak pasti rawatan mana yang sesuai.</p>
    </div>
  </section>
  <section class="mx-auto max-w-6xl px-4 py-8 md:py-14">
    <div class="grid gap-2.5 md:grid-cols-2">
      {services.map((s, i) => <ServiceCard service={s} index={i} />)}
    </div>
    <div class="mt-8 rounded-2xl border border-line p-5 md:flex md:items-center md:justify-between">
      <p class="mb-4 text-base font-bold md:mb-0">Tidak pasti perkhidmatan mana yang anda perlukan?</p>
      <WhatsAppButton topic={`perkhidmatan di ${clinic.name}`} label="Tanya kami" />
    </div>
  </section>
</BaseLayout>
