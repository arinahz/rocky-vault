---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Placeholder from '../../components/Placeholder.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import FaqList from '../../components/FaqList.astro';
import { clinic, services, doctors, type Service } from '../../data/clinic';
import { waMessage } from '../../lib/whatsapp';

export const getStaticPaths = (() =>
  services.map((service) => ({ params: { slug: service.slug }, props: { service } }))) satisfies GetStaticPaths;

interface Props {
  service: Service;
}

const { service } = Astro.props;
const doctor = doctors.find((d) => d.slug === service.doctor);
const related = services.filter((s) => s.slug !== service.slug).slice(0, 3);

const facts = [
  { label: 'Tempoh sesi', value: service.facts.duration },
  { label: 'Harga', value: service.facts.price },
  { label: 'Temujanji', value: service.facts.booking },
  { label: 'Masa pemulihan', value: service.facts.recovery },
];

const goodToKnow = [
  { title: 'Persediaan', text: service.preparation },
  { title: 'Selepas rawatan', text: service.aftercare },
  { title: 'Risiko dan kesan sampingan', text: service.risks },
];
---

<BaseLayout
  title={service.metaTitle ?? `${service.name} di ${clinic.area} | ${clinic.name}`}
  description={service.metaDescription ?? `${service.short} Tanya tentang ${service.name} di ${clinic.name}, ${clinic.area} melalui WhatsApp.`}
  waTopic={service.name}
  waLabel="WhatsApp tentang rawatan ini"
  disclaimer="Hasil rawatan berbeza mengikut individu. Maklumat ini bukan pengganti konsultasi dengan doktor."
>
  <!-- Hero -->
  <section class="bg-tint">
    <div class="mx-auto grid max-w-6xl gap-6 px-4 pt-4 pb-7 md:grid-cols-2 md:items-center md:gap-12 md:py-14">
      <div>
        <nav aria-label="Breadcrumb" class="mb-4 flex flex-wrap items-center gap-1.5 text-[13px] text-muted">
          <a href="/" class="text-muted no-underline">Utama</a><span aria-hidden="true">/</span>
          <a href="/perkhidmatan/" class="text-muted no-underline">Perkhidmatan</a><span aria-hidden="true">/</span>
          <span class="font-semibold text-ink">{service.name}</span>
        </nav>
        <h1 class="mb-3 text-[30px] leading-[1.15] font-extrabold tracking-[-0.02em] md:text-[44px]">
          {service.name} di {clinic.name}, {clinic.area}
        </h1>
        <p class="mb-5 text-base leading-relaxed text-body">{service.intro}</p>
        <dl class="mb-5 grid grid-cols-2 gap-2">
          {
            facts.map((f) => (
              <div class="flex flex-col gap-0.5 rounded-xl border border-placeholder bg-white p-3">
                <dt class="text-xs font-semibold text-muted">{f.label}</dt>
                <dd class="text-[15px] font-bold">{f.value}</dd>
              </div>
            ))
          }
        </dl>
        <WhatsAppButton topic={service.name} label="Tanya tentang rawatan ini" />
        <p class="mt-3 rounded-xl border border-dashed border-[#a7b4c6] bg-white px-3 py-2.5 text-[13px] leading-snug text-body">
          <span class="font-bold text-wa">Mesej WhatsApp: </span>“{waMessage(service.name)}”
        </p>
      </div>
      <Placeholder label="[TODO: Foto sebenar bilik atau peralatan rawatan]" class="h-[200px] md:h-[420px]" />
    </div>
  </section>

  <div class="mx-auto max-w-3xl px-4">
    <!-- About -->
    <section class="pt-8">
      <h2 class="mb-3 text-[23px] leading-tight font-extrabold md:text-[28px]">Tentang rawatan ini</h2>
      {service.about.map((p) => <p class="mb-3 text-base leading-[1.65] text-body">{p}</p>)}
    </section>

    <!-- Suitable for -->
    <section class="pt-4">
      <h2 class="mb-3.5 text-[23px] leading-tight font-extrabold md:text-[28px]">Mungkin sesuai jika anda</h2>
      <ul class="flex flex-col gap-2.5">
        {
          service.suitable.map((s) => (
            <li class="flex items-start gap-3 text-[15px] leading-normal">
              <Icon name="check" strokeWidth={2.2} class="mt-px flex-none text-brand" />
              {s}
            </li>
          ))
        }
      </ul>
      <p class="mt-3.5 text-[13px] leading-normal text-muted">Kesesuaian rawatan ditentukan oleh doktor selepas konsultasi.</p>
    </section>
  </div>

  <!-- Process -->
  <section class="mt-7 bg-tint">
    <div class="mx-auto max-w-3xl px-4 py-8">
      <h2 class="mb-4 text-[23px] leading-tight font-extrabold md:text-[28px]">Apa yang berlaku semasa lawatan</h2>
      <ol class="flex flex-col">
        {
          service.steps.map((st, i) => (
            <li class="flex gap-3.5 pb-4">
              <span class="flex size-8 flex-none items-center justify-center rounded-full bg-brand text-sm font-extrabold text-white">{i + 1}</span>
              <span class="flex flex-col gap-0.5 pt-1">
                <span class="text-base font-bold">{st.title}</span>
                <span class="text-sm leading-normal text-muted">{st.text}</span>
              </span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <div class="mx-auto max-w-3xl px-4">
    <!-- Good to know -->
    <section class="py-8">
      <h2 class="mb-3.5 text-[23px] leading-tight font-extrabold md:text-[28px]">Perkara yang perlu anda tahu</h2>
      <div class="flex flex-col gap-3.5 rounded-2xl border border-line p-[18px]">
        {
          goodToKnow.map((g) => (
            <div class="flex flex-col gap-1">
              <span class="text-sm font-bold">{g.title}</span>
              <span class="text-sm leading-relaxed text-body">{g.text}</span>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Doctor -->
    {
      doctor && (
        <section class="pb-8">
          <div class="flex items-center gap-3.5 rounded-2xl border border-line bg-slate-50 p-4">
            <div role="img" aria-label="Foto doktor" class="size-16 flex-none rounded-full bg-placeholder" />
            <div class="flex flex-col gap-0.5">
              <span class="text-xs font-semibold text-muted">Dikendalikan oleh</span>
              <span class="text-base font-extrabold">{doctor.name}</span>
              <span class="text-[13px] font-semibold text-brand">
                {doctor.qualifications} · MMC {doctor.mmc}
              </span>
            </div>
          </div>
        </section>
      )
    }

    <!-- FAQ -->
    <section class="pb-9">
      <h2 class="mb-3 text-[23px] leading-tight font-extrabold md:text-[28px]">Soalan tentang {service.name}</h2>
      <FaqList items={service.faqs} />
    </section>
  </div>

  <!-- Related -->
  {
    related.length > 0 && (
      <section class="border-t border-line bg-slate-50">
        <div class="mx-auto max-w-6xl px-4 py-8">
          <h2 class="mb-3.5 text-xl font-extrabold">Perkhidmatan lain</h2>
          <div class="flex gap-2.5 overflow-x-auto pb-1 md:grid md:grid-cols-3">
            {related.map((r) => (
              <a href={`/perkhidmatan/${r.slug}/`} class="flex w-[200px] flex-none flex-col gap-1.5 rounded-2xl border border-line bg-white p-4 text-ink no-underline md:w-auto">
                <span class="text-[15px] font-bold">{r.name}</span>
                <span class="text-[13px] font-semibold text-brand">Ketahui lanjut</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Final CTA -->
  <section class="bg-brand text-white">
    <div class="mx-auto max-w-6xl px-4 py-9 md:flex md:items-center md:justify-between md:py-14">
      <div>
        <h2 class="mb-2.5 text-2xl leading-tight font-extrabold md:text-[30px]">Masih ada soalan tentang {service.name}?</h2>
        <p class="mb-5 text-[15px] leading-relaxed text-slate-200 md:mb-0">Hantar soalan anda. Staf kami akan balas dalam waktu operasi.</p>
      </div>
      <WhatsAppButton topic={service.name} variant="inverse" />
    </div>
  </section>
</BaseLayout>
